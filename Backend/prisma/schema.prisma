datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  BANK_SLIP_PENDING
  PROCESSING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  COD
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  phone      String?
  address    String?
  city       String?
  district   String?
  postalCode String?
  role       Role     @default(CUSTOMER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id           String         @id @default(uuid())
  name         String
  price        Float
  stock        Int            @default(0)
  categoryName String
  category     Category       @relation(fields: [categoryName], references: [name])
  badge        String?
  description  String
  details      String?
  image        String
  hoverImage   String?
  featured     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  colors       ProductColor[]
  orderItems   OrderItem[]
}

model ProductColor {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  hex       String
  image     String?
  price     Float
  stock     Int     @default(0)
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  customerName  String
  email         String
  phone         String
  address       String
  totalAmount   Float
  shippingCost  Float         @default(0)
  paymentMethod PaymentMethod
  orderStatus   OrderStatus   @default(PENDING)
  bankSlipUrl   String?
  depositRef    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  colorName String?
  quantity  Int
  price     Float
}
